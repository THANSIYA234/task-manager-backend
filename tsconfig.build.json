{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist", // compiled JS goes here
    "rootDir": "src", // strip "src" folder in dist
    "incremental": true,
    "module": "commonjs",
    "target": "ES2020",
    "strict": true,
    "declaration": false,
    "esModuleInterop": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "test", "dist", "**/*.spec.ts"]
}
